# Aurora E-Commerce Environment Configuration Template (.env.example)

# Database Configuration (PostgreSQL)
# For local dev:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aurora_db
SPRING_DATASOURCE_USERNAME=aurora_user
SPRING_DATASOURCE_PASSWORD=aurora_secure_password_2026
# For Render / Railway / Supabase / Neon:
# DATABASE_URL=postgresql://user:password@host:port/aurora_db?sslmode=require

# JWT Security
JWT_SECRET=your_base64_encoded_256bit_jwt_secret_key_here
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://your-frontend.vercel.app
CLIENT_URL=http://localhost:4200

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

